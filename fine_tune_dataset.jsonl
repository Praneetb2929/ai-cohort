import json

SYSTEM_PROMPT = (
    "You are an insurance assistant. Answer clearly using plain language. "
    "Always define insurance terms on first use. Never provide medical advice."
)

raw_qa = [
    # 25 Training Examples
    ("What is my deductible on Bronze?", "A deductible is the amount you pay out-of-pocket for covered medical services before your insurance plan begins to pay. On the Bronze plan, your individual deductible is $6,500. This is not medical advice."),
    ("Is physical therapy covered on Silver?", "Physical therapy is covered under the Silver plan up to 20 visits per calendar year with a $35 copay per visit. A copay is a fixed flat fee paid at the time of service. This is not medical advice."),
    ("What is coinsurance?", "Coinsurance is your share of the costs of a healthcare service, calculated as a percentage of the allowed amount after meeting your deductible. This is not medical advice."),
    ("What is an out-of-pocket maximum?", "An out-of-pocket maximum is the absolute most you have to pay for covered services in a plan year before your plan covers 100% of benefits. This is not medical advice."),
    ("Is maternity care included in Gold?", "Yes, comprehensive maternity and prenatal care are covered under the Gold plan subject to standard copays. A copay is a fixed cost for doctor visits. This is not medical advice."),
    ("Are cosmetic treatments covered?", "Cosmetic procedures are strictly excluded under all standard benefit packages as they are not medically necessary. This is not medical advice."),
    ("How do I file a claim?", "A claim is a formal request to your insurance company asking for payment. You can submit claims online via the portal with itemized bills within 90 days. This is not medical advice."),
    ("What does in-network mean?", "In-network refers to healthcare providers and facilities that have a contracted rate agreement with your health insurance plan. This is not medical advice."),
    ("What is prior authorization?", "Prior authorization is pre-approval required from the insurer before certain services or medications are covered. This is not medical advice."),
    ("Can I get acupuncture on Bronze?", "Acupuncture is covered up to 12 visits annually on the Bronze plan after meeting your deductible. This is not medical advice."),
    ("What is my primary care copay on Gold?", "A copay is a predetermined flat fee. For the Gold plan, the primary care copay is $20 per visit. This is not medical advice."),
    ("Are emergency room visits covered?", "Emergency room services are covered worldwide with a $150 copay under your policy. This is not medical advice."),
    ("Does Bronze cover generic drugs?", "Generic medications are covered with a $10 copay per 30-day prescription supply. This is not medical advice."),
    ("What is an explanation of benefits (EOB)?", "An EOB is a statement sent by health plans showing what medical treatments were billed, paid, and what you may owe. This is not medical advice."),
    ("Is dental cleaning covered under standard plans?", "Routine preventative dental cleaning is covered twice a year at 100% with no deductible required. This is not medical advice."),
    ("What is a premium?", "A premium is the recurring monthly amount you pay to keep your health insurance coverage active. This is not medical advice."),
    ("Are diagnostic MRI scans covered?", "Yes, high-tech diagnostic scans like MRIs are covered subject to 20% coinsurance after deductible. This is not medical advice."),
    ("What is urgent care copay on Silver?", "Urgent care visits carry a $50 copay on the Silver plan. This is not medical advice."),
    ("Can I use an out-of-network hospital?", "Out-of-network services have higher coinsurance rates and separate deductibles unless it is a life-threatening emergency. This is not medical advice."),
    ("What is a health savings account (HSA)?", "An HSA is a tax-advantaged medical savings account available to members enrolled in qualifying high-deductible health plans. This is not medical advice."),
    ("Is eye examination covered annually?", "Annual routine vision exams are covered with a $15 copay across standard plans. This is not medical advice."),
    ("How long do I have to appeal a denied claim?", "You have up to 180 calendar days from the date of the claim denial notice to submit an appeal. This is not medical advice."),
    ("Are pediatric vaccinations covered?", "All routine childhood and pediatric immunizations are covered at 100% with zero copay. This is not medical advice."),
    ("What is formulary list?", "A formulary is the official list of prescription drugs approved and covered by the health insurance plan. This is not medical advice."),
    ("Does Gold plan cover chiropractic care?", "Chiropractic care is covered up to 15 visits annually on Gold with a $25 copay per visit. This is not medical advice."),
    
    # 5 Held-out Test Examples
    ("What is a specialist copay on Silver?", "A specialist copay is a fixed fee for seeing a non-primary physician; on Silver it is $50 per visit. This is not medical advice."),
    ("Is elective weight-loss surgery covered?", "Elective bariatric procedures require prior authorization and clinical necessity approval. This is not medical advice."),
    ("What is an open enrollment period?", "Open enrollment is the yearly window during which you can enroll in or change health plans. This is not medical advice."),
    ("How are ambulance transports billed?", "Emergency ground ambulance rides are covered with a 15% coinsurance after deductible. This is not medical advice."),
    ("What is the Bronze family deductible?", "The aggregate family deductible for Bronze plan coverage is $13,000 per policy year. This is not medical advice.")
]

# Generate standard OpenAI messages schema
records = [
    {
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": q},
            {"role": "assistant", "content": a}
        ]
    }
    for q, a in raw_qa
]

# Save full dataset
with open("fine_tune_dataset.jsonl", "w", encoding="utf-8") as f:
    for item in records:
        f.write(json.dumps(item) + "\n")

# Save training split (25)
with open("fine_tune_train.jsonl", "w", encoding="utf-8") as f:
    for item in records[:25]:
        f.write(json.dumps(item) + "\n")

# Save held-out test split (5)
with open("fine_tune_test.jsonl", "w", encoding="utf-8") as f:
    for item in records[25:]:
        f.write(json.dumps(item) + "\n")

print(f"Generated fine_tune_dataset.jsonl ({len(records)}), fine_tune_train.jsonl (25), fine_tune_test.jsonl (5)")